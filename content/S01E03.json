  "interactions": [
    {
      "id": "ch3-fair",
      "kind": "single_choice",
      "label": "Fair rules",
      "prompt": "Which rule makes the race fair?",
      "options": [
        {
          "id": "push",
          "text": "Everyone pushes as hard as they can."
        },
        {
          "id": "same",
          "text": "Everyone lets go from the same start line."
        },
        {
          "id": "head",
          "text": "The smallest car starts halfway down."
        }
      ],
      "answer": "same",
      "hint": "A fair race keeps things the same for everyone. What should be the same?",
      "explain": "Same start and no pushing means the race really tests the cars — not who pushes hardest.",
      "retry": true
    },
    {
      "id": "ch3-ramp",
      "kind": "explore",
      "label": "Move the ramp",
      "prompt": "Pick a ramp height and watch how far the car rolls. Try all three!",
      "options": [
        {
          "id": "h1",
          "text": "1 block",
          "h": 1,
          "result": 3
        },
        {
          "id": "h2",
          "text": "2 blocks",
          "h": 2,
          "result": 5
        },
        {
          "id": "h3",
          "text": "3 blocks",
          "h": 3,
          "result": 7
        }
      ],
      "explain": "Higher ramp, farther roll — on our floor, with our car. Gravity gives the car more speed from a higher start."
    },
    {
      "id": "ch3-compare",
      "kind": "single_choice",
      "label": "How much farther?",
      "prompt": "Low ramp: 3 blocks. High ramp: 7 blocks. How many more blocks did the high ramp go?",
      "options": [
        {
          "id": "3",
          "text": "3"
        },
        {
          "id": "4",
          "text": "4"
        },
        {
          "id": "5",
          "text": "5"
        },
        {
          "id": "10",
          "text": "10"
        }
      ],
      "answer": "4",
      "hint": "Count up from 3 to 7 on your fingers: 4, 5, 6, 7. How many fingers?",
      "explain": "7 − 3 = 4. The high ramp sent the car 4 blocks farther.",
      "retry": true
    }
  ],
