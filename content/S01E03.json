  "revision": "1.0",
  "title": "The Great Ramp Race",
  "hook": "Brian wants to win the Great Ramp Race with a giant push — but what does a race really test?",
  "reading_minutes": 7,
  "core_lesson": "A fair test changes one thing at a time — and fair play makes the result mean something.",
  "new_terms": [
    "gravity",
    "measure"
  ],
  "adult_safety_note": "Children use cardboard cars, a low cardboard ramp and counting blocks on the floor. Keep ramps low and stable; no climbing on furniture to build them.",
  "localisation_key_prefix": "s01e03",
  "editorial_status": "draft",
  "learning_objectives": [
    {
      "topic": "Science",
      "goal": "Gravity pulls a car down a ramp; on our floor, a higher start made it roll farther."
    },
    {
      "topic": "Fair test",
      "goal": "Change only the ramp height; keep the car, start line and 'just let go' the same."
    },
    {
      "topic": "Measurement",
      "goal": "Measure height and distance with the same unit (blocks)."
    },
    {
      "topic": "Number",
      "goal": "Compare distances: 7 − 3 = 4 blocks farther."
    },
    {
      "topic": "Fair play",
      "goal": "Pushing wins nothing real; Brian apologises and the team races fairly."
    },
    {
      "topic": "Engineering honesty",
      "goal": "Results are for our car, ramp and floor — other set-ups give other numbers."
    }
  ],
  "talk_together": [
    "Why couldn't the first race tell anyone who really won?",
    "What did the team keep the same in every test? What did they change?",
    "Have you ever won something in a way that didn't feel fair? What did you do?"
  ],
  "complete": {
    "recall": "Same start. Change one thing. Just let go — and measure!",
    "question": "With a grown-up, prop a book under a board and roll a toy car down it. What happens with one book? Two books?"
  },
